# Writes OUT, a C++ source file with information about the build: version,
# git commit and branch, build date, build type and the commits of the
# bundled libraries. CMakeLists.txt runs it at every build, so that the
# information is always current; OUT is only rewritten when its contents
# change (then only that file is compiled again).
#
# Variables (set with -D): SRC (source directory), OUT, VERSION, STATIC,
# SYSTEM_TVISION, SYSTEM_LIBVTERM.

find_program(GIT_COMMAND git)

# Output of 'git ARGS' run in 'dir', or 'unknown'.
function(git_output var dir)
    set(value "unknown")
    if (GIT_COMMAND AND EXISTS "${dir}")
        execute_process(COMMAND "${GIT_COMMAND}" ${ARGN}
                        WORKING_DIRECTORY "${dir}"
                        OUTPUT_VARIABLE out
                        RESULT_VARIABLE res
                        ERROR_QUIET
                        OUTPUT_STRIP_TRAILING_WHITESPACE)
        if (res EQUAL 0 AND NOT out STREQUAL "")
            set(value "${out}")
        endif()
    endif()
    set(${var} "${value}" PARENT_SCOPE)
endfunction()

# Short commit hash, with '-dirty' if there are uncommitted changes.
# '--match' with a pattern no tag has: always the hash, never a tag name.
function(git_commit var dir)
    git_output(value "${dir}" describe --always --dirty --abbrev=7 --match=no-tag-has-this-name)
    set(${var} "${value}" PARENT_SCOPE)
endfunction()

git_commit(COMMIT "${SRC}")
git_output(BRANCH "${SRC}" rev-parse --abbrev-ref HEAD)
if (BRANCH STREQUAL "HEAD")
    set(BRANCH "detached")
endif()

if (SYSTEM_TVISION)
    set(TVISION "system library")
else()
    git_commit(TVISION "${SRC}/deps/tvision")
endif()
if (SYSTEM_LIBVTERM)
    set(LIBVTERM "system library")
else()
    git_commit(LIBVTERM "${SRC}/deps/vterm/libvterm")
endif()

# Local time of the build machine, with its time zone (e.g. EET).
execute_process(COMMAND date "+%Y-%m-%d %H:%M %Z"
                OUTPUT_VARIABLE DATE
                RESULT_VARIABLE res
                ERROR_QUIET
                OUTPUT_STRIP_TRAILING_WHITESPACE)
if (NOT res EQUAL 0 OR DATE STREQUAL "")
    string(TIMESTAMP DATE "%Y-%m-%d %H:%M UTC" UTC)
endif()

if (STATIC)
    set(KIND "static")
else()
    set(KIND "dynamic")
endif()

function(c_string var value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${var} "\"${value}\"" PARENT_SCOPE)
endfunction()

set(text "// Generated by scripts/buildinfo.cmake at build time. Do not edit.\n\nnamespace buildinfo\n{\n\n")
foreach (pair "version;VERSION" "commit;COMMIT" "branch;BRANCH" "date;DATE"
              "kind;KIND" "tvision;TVISION" "libvterm;LIBVTERM")
    list(GET pair 0 name)
    list(GET pair 1 var)
    c_string(value "${${var}}")
    string(APPEND text "extern const char ${name}[] = ${value};\n")
endforeach()
string(APPEND text "\n} // namespace buildinfo\n")

file(WRITE "${OUT}.tmp" "${text}")
# Copies only if the contents differ (keeps the timestamp otherwise).
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
